+/* one frame from the network into the block being gathered for the host (0: not now, QEMU queues it) */
+static ssize_t ncm_receive(USBNetState *s, const uint8_t *buf, size_t size)
+{
+    uint32_t at;
+    uint8_t *e;
+
+    if (size < 14 || size > ETH_FRAME_LEN + 4) {
+        return size;
+    }
+    if (s->in_len > 0 && (s->in_ptr > 0 || s->ncm_count >= NCM_MAX_DG)) {
+        return 0;
+    }
+    if (s->in_len == 0) {
+        memset(s->in_buf, 0, NCM_DATA_AT);
+        stl_le_p(s->in_buf, NCM_NTH16);
+        stw_le_p(s->in_buf + 4, 12);
+        stw_le_p(s->in_buf + 6, s->ncm_seq++);
+        stw_le_p(s->in_buf + 10, NCM_NDP_AT);
+        stl_le_p(s->in_buf + NCM_NDP_AT, NCM_NDP16);
+        stw_le_p(s->in_buf + NCM_NDP_AT + 4, 8 + 4 * (NCM_MAX_DG + 1));
+        s->in_len = NCM_DATA_AT;
+        s->in_ptr = 0;
+        s->ncm_count = 0;
+        s->ncm_hold_over = false;
+        timer_mod(s->ncm_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + NCM_HOLD_NS);
+    }
+    at = ROUND_UP(s->in_len, 4);
+    if (at + size + 1 > s->ncm_in_max) {
+        return s->ncm_count ? 0 : size;
+    }
+    memset(s->in_buf + s->in_len, 0, at - s->in_len);
+    memcpy(s->in_buf + at, buf, size);
+    e = s->in_buf + NCM_NDP_AT + 8 + 4 * s->ncm_count;
+    stw_le_p(e, at);
+    stw_le_p(e + 2, size);
+    s->ncm_count++;
+    s->in_len = at + size;
+    stw_le_p(s->in_buf + 8, s->in_len);
+    if (s->ncm_count >= NCM_GATHER) {
+        usb_wakeup(s->bulk_in, 0);
+    }
+    return size;
+}
