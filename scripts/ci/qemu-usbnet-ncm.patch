+/* one block from the host: every frame its tables list, checked against the block and this device's layout */
+static void ncm_parse_out(USBNetState *s)
+{
+    uint8_t *b = s->out_buf;
+    uint32_t blen, ndp, nl, k, di, dl;
+    int t;
+
+    if (s->out_ptr < 12 || ldl_le_p(b) != NCM_NTH16 || lduw_le_p(b + 4) != 12) {
+        fprintf(stderr, "usbnet: NCM block from the host has a bad header\n");
+        return;
+    }
+    blen = lduw_le_p(b + 8);
+    if (blen == 0 || blen > s->out_ptr) {
+        blen = s->out_ptr;
+    }
+    ndp = lduw_le_p(b + 10);
+    for (t = 0; t < 8 && ndp; t++) {
+        if (ndp < 12 || ndp % NCM_OUT_ALIGN || ndp + 8 > blen || ldl_le_p(b + ndp) != NCM_NDP16) {
+            fprintf(stderr, "usbnet: NCM table from the host at %u breaks the layout\n", ndp);
+            return;
+        }
+        nl = lduw_le_p(b + ndp + 4);
+        if (nl < 16 || ndp + nl > blen) {
+            fprintf(stderr, "usbnet: NCM table length %u from the host is bad\n", nl);
+            return;
+        }
+        for (k = ndp + 8; k + 4 <= ndp + nl; k += 4) {
+            di = lduw_le_p(b + k);
+            dl = lduw_le_p(b + k + 2);
+            if (!di || !dl) {
+                break;
+            }
+            if (di % NCM_OUT_DIV != NCM_OUT_REM || di + dl > blen || dl < 14) {
+                fprintf(stderr, "usbnet: NCM frame from the host at %u (%u bytes) breaks the layout\n", di, dl);
+                continue;
+            }
+            qemu_send_packet(qemu_get_queue(s->nic), b + di, dl);
+        }
+        ndp = lduw_le_p(b + ndp + 6);
+    }
+}
